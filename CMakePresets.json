{
    "version": 3,
    "configurePresets": [
        {
          "name": "common-base",
          "hidden": true,
          "generator": "Ninja",
          "binaryDir": "${sourceDir}/out/build/${presetName}",
          "installDir": "${sourceDir}/out/install/${presetName}"
        },

        {
          "name": "windows-base",
          "hidden": true,
          "inherits": "common-base",
          "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
          "name": "windows-x64-base",
          "hidden": true,
          "inherits": "windows-base",
          "architecture": { "value": "x64", "strategy": "external" }
        },
        {
          "name": "windows-x86-base",
          "hidden": true,
          "inherits": "windows-base",
          "architecture": { "value": "x86", "strategy": "external" }
        },

        {
            "name": "msvc-x64-debug",
            "displayName": "x64 Debug (MSVC)",
            "inherits": "windows-x64-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-msvc-windows-base.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "msvc-x64-release",
            "displayName": "x64 Release (MSVC)",
            "inherits": "windows-x64-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-msvc-windows-base.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "msvc-x86-debug",
            "displayName": "x86 Debug (MSVC)",
            "inherits": "windows-x86-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-msvc-windows-base.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "msvc-x86-release",
            "displayName": "x86 Release (MSVC)",
            "inherits": "windows-x86-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-msvc-windows-base.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },


        {
            "name": "clang-windows-x64-debug",
            "displayName": "x64 Debug (Clang)",
            "inherits": "windows-x64-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-clang-windows-base.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "clang-windows-x64-release",
            "displayName": "x64 Release (Clang)",
            "inherits": "windows-x64-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-clang-windows-base.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },



        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "common-base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "linux-x64-base",
            "hidden": true,
            "inherits": "linux-base",
            "architecture": { "value": "x64", "strategy": "external" }
        },
        {
            "name": "linux-arm32-base",
            "hidden": true,
            "inherits": "linux-base",
            "architecture": { "value": "arm", "strategy": "external" }
        },
        {
            "name": "linux-arm64-base",
            "hidden": true,
            "inherits": "linux-base",
            "architecture": { "value": "arm64", "strategy": "external" }
        },

        {
            "name": "gnu-linux-x64-debug",
            "displayName": "x64 Debug (GNU Linux)",
            "inherits": "linux-x64-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-gcc-linux-x64.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "gnu-linux-x64-release",
            "displayName": "x64 Release (GNU Linux)",
            "inherits": "linux-x64-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-gcc-linux-x64.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },



        {
            "name": "clang-linux-x64-debug",
            "displayName": "x64 Debug (Clang Linux)",
            "inherits": "linux-x64-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-clang-linux-x64.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "clang-linux-x64-release",
            "displayName": "x64 Release (Clang Linux)",
            "inherits": "linux-x64-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-clang-linux-x64.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },



        {
            "name": "clang-linux-arm32-debug",
            "displayName": "ARM32 Debug (Clang Linux)",
            "inherits": "linux-arm32-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-clang-linux-arm32.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "clang-linux-arm32-release",
            "displayName": "ARM32 Release (Clang Linux)",
            "inherits": "linux-arm32-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-clang-linux-arm32.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },



        {
            "name": "clang-linux-arm64-debug",
            "displayName": "ARM64 Debug (Clang Linux)",
            "inherits": "linux-arm64-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-clang-linux-arm64.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "clang-linux-arm64-release",
            "displayName": "ARM64 Release (Clang Linux)",
            "inherits": "linux-arm64-base",
            "toolchainFile": "${sourceDir}/cmake/toolchain-clang-linux-arm64.cmake",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        }
    ]
}