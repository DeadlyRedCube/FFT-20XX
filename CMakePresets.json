{
    "version": 3,
    "configurePresets": [
        {
          "name": "clang-build-options",
          "hidden": true,
          "environment": {
            "BASE_CXX_FLAGS": "-fno-fast-math -ffp-contract=off -Werror -Wall -pedantic"
          }
        },

        {
            "name": "msvc-windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "environment": {
              "BASE_CXX_FLAGS": "/MP /sdl /Zc:preprocessor /GS /nologo /fp:precise /EHsc /permissive- /Wall /external:W2 /external:anglebrackets /WX"

            }
        },
        {
            "name": "msvc-x64-debug",
            "displayName": "x64 Debug (MSVC)",
            "inherits": "msvc-windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-x64-release",
            "displayName": "x64 Release (MSVC)",
            "inherits": "msvc-x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-x86-debug",
            "displayName": "x86 Debug (MSVC)",
            "inherits": "msvc-windows-base",
            "architecture": {
                "value": "x86",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-x86-release",
            "displayName": "x86 Release (MSVC)",
            "inherits": "msvc-x86-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },




        {
            "name": "clang-windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl.exe",
                "CMAKE_CXX_COMPILER": "clang-cl.exe",
                "CMAKE_LINKER": "lld-link.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "clang-windows-x64-debug",
            "displayName": "x64 Debug (Clang)",
            "inherits": "clang-windows-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-windows-x64-release",
            "displayName": "x64 Release (Clang)",
            "inherits": "clang-windows-x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },



        {
            "name": "gnu-linux-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "gnu-linux-x64-debug",
            "displayName": "x64 Debug (GNU Linux)",
            "inherits": "gnu-linux-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "gnu-linux-x64-release",
            "displayName": "x64 Release (GNU Linux)",
            "inherits": "gnu-linux-x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },



        {
            "name": "clang-linux-base",
            "hidden": true,
            "inherits": "clang-build-options",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "clang-linux-x64-debug",
            "displayName": "x64 Debug (Clang Linux)",
            "inherits": "clang-linux-base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "$env{BASE_CXX_FLAGS} -O0 -g3 -gdwarf-2"
            }
        },
        {
            "name": "clang-linux-x64-release",
            "displayName": "x64 Release (Clang Linux)",
            "inherits": "clang-linux-x64-debug",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS": "$env{BASE_CXX_FLAGS} -O2"
            }
        },



        {
            "name": "clang-linux-arm32-debug",
            "displayName": "ARM32 Debug (Clang Linux)",
            "inherits": "clang-linux-base",
            "architecture": {
                "value": "arm7",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "$env{BASE_CXX_FLAGS} -O0 -g3 -gdwarf-2 --target=arm-linux-gnueabihf"
            }
        },
        {
            "name": "clang-linux-arm32-release",
            "displayName": "ARM32 Release (Clang Linux)",
            "inherits": "clang-linux-arm32-debug",
            "architecture": {
                "value": "arm7",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS": "$env{BASE_CXX_FLAGS} -O2 --target=arm-linux-gnueabihf"
            }
        },



        {
            "name": "clang-linux-arm64-debug",
            "displayName": "ARM64 Debug (Clang Linux)",
            "inherits": "clang-linux-base",
            "architecture": {
                "value": "arm64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "$env{BASE_CXX_FLAGS} -O0 -g3 -gdwarf-2 --target=aarch64-linux-gnu"
            }
        },
        {
            "name": "clang-linux-arm64-release",
            "displayName": "ARM64 Release (Clang Linux)",
            "inherits": "clang-linux-arm64-debug",
            "architecture": {
                "value": "arm64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS": "$env{BASE_CXX_FLAGS} -O2 --target=aarch64-linux-gnu"
            }
        }
    ]
}
